NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Provider pivot (2026-08-13): no Google GenAI key available. NVIDIA NIM's
# llama-nemotron-embed-1b-v2 replaces gemini-embedding-001 for embeddings —
# free, verified live against the real NIM catalog (its predecessor,
# llama-3.2-nv-embedqa-1b-v2, was retired 2026-05-18 — check
# https://integrate.api.nvidia.com/v1/models before trusting a model id from
# docs). Get a key at https://build.nvidia.com. Matches web/.env.example.
NVIDIA_NIM_API_KEY=
INGEST_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
INGEST_EMBEDDING_MODEL_VERSION=v2

# marker's --use_llm correction pass still runs against local Ollama —
# machine-typeset curriculum PDFs, not handwriting, so this is about OCR
# quality on dense equations/diagrams, not the transcription-fidelity risk
# that motivates the vision model choice for student answer scripts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl
