# Supabase — from `supabase status` (local) or the project dashboard (hosted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider pivot (2026-08-13): no Google GenAI key available. NVIDIA NIM is
# the default for vision/OCR + reasoning (free, OpenAI-compatible, ~40 RPM,
# no card on file) and, in production, for the embedder too
# (nvidia/llama-nemotron-embed-1b-v2, truncated to 1024-dim via the
# `dimensions` param — nv-embedqa-e5-v5's native 1024-dim was tempting but
# its 512-token context is too small for real textbook chunks; verified live
# 2026-08-19 against the real /v1/models catalog). Get a key at
# https://build.nvidia.com (free signup). Verify model IDs against
# https://integrate.api.nvidia.com/v1/models before trusting third-party
# docs — the catalog is account/region-gated and changes without notice.
NVIDIA_NIM_API_KEY=
GENKIT_VISION_MODEL=nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
GENKIT_REASONING_MODEL=nim/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Fireworks AI — registered as a Genkit plugin but NOT defaulted anywhere.
# Deliberately held back until the golden set (ingestion/README.md) shows
# where NIM's free tier actually falls short; spend the credit there, not
# blindly. Get a key at https://fireworks.ai.
FIREWORKS_API_KEY=

# Local Ollama — used for offline dev iteration (see web/src/ai/genkit.ts).
# `ollama pull qwen3:8b`, `ollama pull gemma4:e4b` (vision-capable), and
# `ollama pull bge-m3` (embedder) if you want to run flows without hitting
# NIM at all. Production (Vercel) has no reachable Ollama — 127.0.0.1 only
# exists on a dev machine, and Ollama can't be hosted ON Vercel either (needs
# a persistent daemon, not a stateless function) — so production embeds via
# NIM's llama-nemotron-embed-1b-v2 instead (2048-dim truncated to 1024,
# matches the vector(1024) schema; same NVIDIA_NIM_API_KEY above, no
# separate signup).
OLLAMA_BASE_URL=http://127.0.0.1:11434
