# App
# Absolute origin of this deployment — used to build OAuth and verification URLs.
NEXT_PUBLIC_SITE_URL=https://sheratutor.tech

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Provider (Zoho SMTP / ZeptoMail)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=support@sheratutor.tech
ZOHO_SMTP_PASS=your-app-specific-password

# Administration
ADMIN_EMAILS=syed.salman.reza.181@gmail.com

# AI Provider Keys
AGENTROUTER_API_KEY=sk-your-agentrouter-key
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_SYSTEM_TOKEN=your-system-token
NVIDIA_NIM_API_KEY=nvapi-your-nim-key
FIREWORKS_API_KEY=fw_your-fireworks-key
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Genkit Model Routing (NVIDIA NIM Verified Active Endpoints)
GENKIT_VISION_MODEL=nim/meta/llama-3.2-11b-vision-instruct
GENKIT_REASONING_MODEL=nim/meta/llama-3.2-11b-vision-instruct
GENKIT_FAST_MODEL=nim/meta/llama-3.2-11b-vision-instruct
GENKIT_PAPER_MODEL=nim/nvidia/nemotron-3-nano-30b-a3b

# Internal Worker Secret
INTERNAL_WORKER_SECRET=your-internal-worker-secret
