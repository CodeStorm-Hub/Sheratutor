# App
# Absolute origin of this deployment — used to build OAuth and verification URLs.
NEXT_PUBLIC_SITE_URL=https://sheratutor.tech

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Provider (Zoho SMTP / ZeptoMail)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=support@sheratutor.tech
ZOHO_SMTP_PASS=your-app-specific-password

# Administration
ADMIN_EMAILS=syed.salman.reza.181@gmail.com

# Google AI Studio Gemini API Keys
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_SECONDARY=your-secondary-gemini-api-key
GEMINI_API_KEY_TERTIARY=your-tertiary-gemini-api-key

# Local Ollama (Optional offline dev)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Genkit Model Routing (Google AI Studio Free Gemini API)
GENKIT_VISION_MODEL=googleai/gemini-2.5-flash
GENKIT_REASONING_MODEL=googleai/gemini-2.5-flash
GENKIT_FAST_MODEL=googleai/gemini-2.5-flash
GENKIT_PAPER_MODEL=googleai/gemini-2.5-flash
GENKIT_FALLBACK_REASONING_MODEL=googleai/gemini-2.5-flash-lite
# Embedder is fixed in code: gemini-embedding-2 @ dimensions=1024

# Internal Worker Secret
INTERNAL_WORKER_SECRET=your-internal-worker-secret
